{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "TSES OTP Authentication Service",
		"description": "Postman Collection for testing OTP Request, OTP Verification, and Audit Logs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Request OTP",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"user@example.com\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/api/v1/auth/otp/request",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
						"auth",
						"otp",
						"request"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Verify OTP & Get JWT",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}"
				},
				"url": {
					"raw": "http://localhost:8000/api/v1/auth/otp/verify",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
						"auth",
						"otp",
						"verify"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Get Audit Logs (Protected)",
			"request": {
				"auth": {
					"type": "bearer",
					"bearer": [
						{
							"key": "token",
							"value": "{{access_token}}",
							"type": "string"
						}
					]
				},
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8000/api/v1/audit/logs",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8000",
					"path": [
						"api",
						"v1",
						"audit",
						"logs"
					]
				}
			},
			"response": []
		}
	]
}
