# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres
POSTGRES_DB=tses_otp
POSTGRES_USER=tses
POSTGRES_PASSWORD=tses
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# OTP behavior
OTP_TTL_SECONDS=300
OTP_REQUEST_MAX_PER_EMAIL=3
OTP_REQUEST_WINDOW_EMAIL_SECONDS=600
OTP_REQUEST_MAX_PER_IP=10
OTP_REQUEST_WINDOW_IP_SECONDS=3600
OTP_MAX_FAILED_ATTEMPTS=5
OTP_LOCKOUT_WINDOW_SECONDS=900
NORMALIZE_GMAIL_PLUS_ALIAS=0
